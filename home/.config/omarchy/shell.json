{
  "version": 1,
  "idle": {
    "screensaver": 0,
    "lock": 0
  },
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "njpatel.omapager"
        },
        {
          "id": "petrzpav.indicators",
          "items": [
            "Dictation",
            "ScreenRecording",
            "Reminder",
            "NightLight",
            "StayAwake"
          ]
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "dotfiles",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/dotfiles-age",
          "interval": 600,
          "onClick": "omarchy-launch-floating-terminal-with-presentation ~/.local/bin/dotfiles-sync",
          "tooltip": "Dotfiles backup"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "exec": "~/.config/omarchy/plugins/petrzpav.alerts/bin/alerts-bar",
          "id": "alerts",
          "interval": 10,
          "onClick": "omarchy-launch-floating-terminal-with-presentation ~/.config/omarchy/plugins/petrzpav.alerts/bin/alerts-panel",
          "tooltip": "Alerts",
          "type": "command"
        },
        {
          "id": "petrzpav.wallswap",
          "interval": "180",
          "sources": "wallhaven"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "bottom",
    "transparent": true
  },
  "plugins": [
    {
      "id": "george.dim"
    }
  ]
}
